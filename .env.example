# --- Database (Supabase) ---
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Session pooler / direct connection (port 5432) — used by Alembic migrations
DATABASE_URL_DIRECT=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Read-only role for Text-to-SQL (phase 4)
DATABASE_URL_LLM_READONLY=

# --- Supabase Storage ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# --- Auth ---
# First admin key; lets you call admin endpoints before any key exists in the DB.
# Generate one with: python -c "import secrets; print('rkk_' + secrets.token_urlsafe(32))"
ADMIN_BOOTSTRAP_KEY=
CRON_SECRET=

# --- LLM providers ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
JINA_API_KEY=

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
CONFIG_PATH=config.yaml
